<?php
declare(strict_types=1);

namespace {{ namespace }};

use App\Console\Command;

/**
 * Generated by `{{ cli_prefix }} make:command`.
 *
 * Registered by adding this class to the `$commands` array in App\Console\Kernel.
 * Until it is listed there, WP-CLI never learns the command exists — the file
 * being present and autoloadable is not enough.
 */
final class {{ class }} extends Command
{
    /**
     * The name WP-CLI registers this command under, including its namespace.
     *
     * Read from config rather than hardcoded, so a rebranded project's commands
     * stay grouped under its own prefix instead of this framework's default.
     */
    public function getName(): string
    {
        return config('app.cli_prefix', \Framework\Config\Config::DEFAULT_CLI_PREFIX) . ' {{ command }}';
    }

    public function getDescription(): string
    {
        return 'TODO: describe what this command does.';
    }

    /**
     * Run the command.
     *
     * Both arrays arrive as raw strings — WP-CLI does no validation for you — so
     * anything that must be an integer, a path or one of a fixed set is the
     * command's job to check before use.
     *
     * @param array<int, string>    $args      Positional arguments.
     * @param array<string, string> $assocArgs `--flag=value` arguments.
     */
    public function handle(array $args, array $assocArgs): void
    {
        $this->info('{{ class }} ran.');
    }
}
