# Copy this file to .env and fill in your own values.
#
# This template ships with empty (or production-safe) defaults so the plugin
# keeps running when environment variables are only provided server-side
# (e.g. via hosting control panels, Docker, or a secrets manager).
#
# Core identity
#
APP_NAME=
APP_ENV=local
APP_DEBUG=true
#
# Naming and scoping
#
APP_PREFIX=
APP_NAMESPACE=
CLI_PREFIX=
REST_NAMESPACE=
#
# Paths
#
APP_VIEWS_PATH=
#
# Secrets
#
API_SECRET_KEY=
