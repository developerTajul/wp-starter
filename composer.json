{
  "name": "devlinkstudios/wp-mini-laravel",
  "description": "Enterprise-Grade Framework-agnostic WordPress plugin architecture.",
  "type": "wordpress-plugin",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "devlinkstudios/wp-mini-laravel-framework": "*@dev",
    "vlucas/phpdotenv": "^5.6"
  },
  "repositories": [
    {
      "type": "path",
      "url": "./framework"
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Core\\": "core/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    },
    "classmap": [
      "tests/stubs/wp-classes.php"
    ]
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-text",
    "rebrand": "@php framework/bin/init-plugin.php"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
